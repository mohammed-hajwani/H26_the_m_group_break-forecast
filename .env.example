# Copy to .env (git-ignored) and fill in. Never commit .env.

# Primary: Gemma 4 on the Gemini API (Google AI Studio key)
BF_API_KEY=
BF_MODEL=gemma-4-31b-it
BF_MODEL_ENDPOINT=https://generativelanguage.googleapis.com/v1beta
# Second hosted model on the same API, tried when the primary is overloaded (empty = disabled)
BF_SECONDARY_MODEL=gemma-4-26b-a4b-it

# Seconds to wait for one model answer before retrying / failing over (default 90)
BF_MODEL_TIMEOUT=90
# Attempts per backend before falling over to the next one (default 3)
BF_MODEL_RETRIES=3

# Fallback: local Ollama (native API is used automatically for port 11434)
BF_FALLBACK_MODEL=gemma4:12b-it-qat
BF_FALLBACK_ENDPOINT=http://localhost:11434/v1
BF_LOCAL_TIMEOUT=300
BF_LOCAL_NUM_CTX=16384
BF_LOCAL_MAX_TOKENS=2048

# Optional: raises the GitHub API limit for repo-status checks
GITHUB_TOKEN=
